{
  "name": "@neon/realtime",
  "version": "0.1.2",
  "description": "Typed backend and browser SDKs for live queries.",
  "keywords": [
    "neon",
    "database",
    "postgres",
    "live-query",
    "realtime",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neondatabase/neon-pkgs.git",
    "directory": "packages/realtime"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Neon",
    "url": "https://neon.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.react-native.d.ts",
        "import": "./dist/index.react-native.js",
        "default": "./dist/index.react-native.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./schema/realtime-query-capability-v1.schema.json": "./schema/realtime-query-capability-v1.schema.json",
    "./schema/realtime-protocol-v1.schema.json": "./schema/realtime-protocol-v1.schema.json"
  },
  "files": [
    "README.md",
    "dist/",
    "package.json",
    "schema/"
  ],
  "dependencies": {
    "base64-js": "^1.5.1",
    "postgres-array": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.0.9",
    "ajv": "^8.20.0",
    "console-fail-test": "0.5.0",
    "fast-check": "^4.9.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsdown": "^0.14.1",
    "typescript": "^5.9.0",
    "vitest": "^3.0.9",
    "ws": "^8.21.2"
  },
  "peerDependencies": {
    "ws": "^8.21.2"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "provenance": false
  },
  "scripts": {
    "build": "npm run generate:check && tsc --noEmit && tsdown",
    "generate": "npm run generate:capability && npm run generate:protocol",
    "generate:capability": "node scripts/generate-capability-types.mjs",
    "generate:capability:check": "node scripts/generate-capability-types.mjs --check",
    "generate:check": "npm run generate:capability:check && npm run generate:protocol:check",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "generate:protocol:check": "node scripts/generate-protocol.mjs --check",
    "test": "vitest --passWithNoTests",
    "test:ci": "npm run generate:check && vitest run --passWithNoTests",
    "tsc": "tsc"
  }
}